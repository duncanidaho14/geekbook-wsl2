
<turbo-stream action="update" target="search-results">
    <template>
        <div class="container mx-auto flex items-center flex-wrap pt-4 pb-12">
            {% for book in books %}
                <div class="md:w-1/3 xl:w-1/4 p-6 flex flex-col">
                    <a href="{{ path('app_show_book', {'slug': book.slug }) }}">
                        <img class="w-full h-full hover:grow hover:shadow-lg" src="{{ book.firstCover }}"/>
                        <div class="pt-3 flex items-center justify-between">
                            <h3>{{ book.title|slice(0, 25) }} ...</h3>
                            {% include 'layout/rating.html.twig' with {'rating': book.getAvgRatings} %}
                        </div>
                        <div class="flex">
                            <button class="w-full items-end rounded-full border border-sky-500 font-black text-blue-800 dark:bg-gray-800 dark:text-white">{{ book.price }} €</button>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    <template>
</turbo-stream>

<turbo-stream action="prepend" target="comments-list">
    <template>
        <div class="flex flex-col">
            {% for comment in comments %}
                {{ include('book/_comment.html.twig', { comment, book: book }) }}
            {% endfor %}
        </div>
    </template>
</turbo-stream>

<turbo-stream action="update" target="new-comment-form">
    <template>
        <div>
            {{ include('book/_form.html.twig', { form }) }}
        </div>
    </template>
</turbo-stream>